---
import Heading from "./Heading.astro";
import Info from "./Info.astro";
import Journals from "./Journals.astro";
import Sources from "./Sources.astro";
import Links from "./Links.astro";
import GridLine from "./GridLine.astro";
---

<div id="container">
	<div id="background" aria-hidden="true"></div>

	<main>
		<Heading />

		<GridLine />

		<header>
			<a href="#info">Informácie</a>
			<a href="#journals">Týždenník</a>
			<a href="#links">Odkazy</a>
			<a href="#sources">Zdroje</a>
		</header>

		<div id="content">
			<Info />
			<Journals />
			<Links />
			<Sources />
		</div>
	</main>
</div>

<style is:global>
	a {
		color: var(--text-secondary);
	}
</style>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		padding-block: 1rem;
		position: relative;
	}

	header a {
		position: relative;
		text-decoration: none;
	}

	header a::before {
		content: "";
		position: absolute;
		display: block;
		width: 100%;
		height: 2px;
		bottom: 0;
		left: 0;
		background-color: oklch(40% 0 0);
		transform: scaleX(0);
		transform-origin: top left;
		transition: transform 0.2s ease;
	}

	header::before,
	header::after {
		content: "";
		display: block;
		position: absolute;
		left: calc(-1rem + 1px);
		height: 0.5rem;
		width: calc(100% + 2rem - 2px);

		--pattern-fg: var(--grid-line-color);

		background-image: repeating-linear-gradient(
			315deg,
			var(--pattern-fg) 0,
			var(--pattern-fg) 1px,
			transparent 0,
			transparent 50%
		);
		background-size: 10px 10px;
	}

	header::before {
		top: 0;
		border-bottom: 1px solid var(--grid-line-color);
	}

	header::after {
		bottom: 0;
		border-top: 1px solid var(--grid-line-color);
	}

	header a:hover::before {
		transform: scaleX(1);
	}

	#container {
		position: relative;
		height: 100%;
		width: 100%;
		max-width: 768px;
		margin: 0 auto;

		padding-inline: 4rem;
		padding-top: 2rem;
		padding-bottom: 1rem;
		box-sizing: border-box;
	}

	#container::before,
	#container::after {
		content: "";
		display: block;
		position: absolute;
		top: 0;
		height: 100%;
		min-height: 100vh;
		width: 2rem;
		border-inline: 1px solid var(--grid-line-color);

		--pattern-fg: var(--grid-line-color);

		background-image: repeating-linear-gradient(
			315deg,
			var(--pattern-fg) 0,
			var(--pattern-fg) 1px,
			transparent 0,
			transparent 50%
		);
		background-size: 10px 10px;
	}

	#container::before {
		left: 1rem;
	}

	#container::after {
		right: 1rem;
	}

	#content {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
</style>
