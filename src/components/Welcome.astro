---
import Heading from "./Heading.astro";
import Info from "./Info.astro";
import Journals from "./Journals.astro";
import Sources from "./Sources.astro";
import Links from "./Links.astro";
import GridLine from "./GridLine.astro";
import Header from "./Header.astro";
---

<div id="container">
	<div id="background" aria-hidden="true"></div>

	<main>
		<Heading />

		<GridLine />

		<Header />

		<div id="content">
			<Info />
			<Journals />
			<Links />
			<Sources />
		</div>
	</main>
</div>

<style is:global>
	a {
		color: var(--text-secondary);
	}

	.decorate ul,
	ul.decorate {
		list-style: none;
		padding-left: 1rem;
	}

	.decorate li {
		position: relative;
	}

	.decorate li::before {
		content: "";
		position: absolute;
		left: -18px;
		top: 3px;

		width: 0.75rem;
		height: 0.75rem;

		background-color: var(--text-tertiary);

		-webkit-mask: url("/src/assets/chevron-right.svg") no-repeat center /
			contain;
		mask: url("/src/assets/chevron-right.svg") no-repeat center / contain;
	}
</style>

<style>
	#container {
		position: relative;
		height: 100%;
		width: 100%;
		max-width: 768px;
		margin: 0 auto;

		padding-inline: 4rem;
		padding-top: 2rem;
		padding-bottom: 1rem;
		box-sizing: border-box;
	}

	#container::before,
	#container::after {
		content: "";
		display: block;
		position: absolute;
		top: 0;
		height: 100%;
		min-height: 100vh;
		width: 2rem;
		border-inline: 1px solid var(--grid-line-color);

		--pattern-fg: var(--grid-line-color);

		background-image: repeating-linear-gradient(
			315deg,
			var(--pattern-fg) 0,
			var(--pattern-fg) 1px,
			transparent 0,
			transparent 50%
		);
		background-size: 10px 10px;
	}

	#container::before {
		left: 1rem;
	}

	#container::after {
		right: 1rem;
	}

	#content {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	@media (max-width: 575.98px) {
		#container {
			padding-inline: 0.75rem;
		}

		#container::before,
		#container::after {
			display: none;
		}
	}
</style>
