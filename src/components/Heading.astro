---
import GridLine from "./GridLine.astro";
---

<GridLine />
<div id="heading">
	<h1>Bakalárska práca</h1>
	<p>
		<span id="name">Jakub Marček</span> marcek18@uniba.sk
	</p>
</div>

<style>
	#heading {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;

		width: 100%;
		gap: 1rem;
		padding-block: 0.5rem;
	}

	#heading p {
		font-size: 0.875rem;
		margin: 0;
		color: var(--text-secondary);
	}

	#heading #name {
		display: block;
		font-weight: 500;
	}

	h1 {
		margin: 0;
		font-size: 2.25rem;
	}
</style>
