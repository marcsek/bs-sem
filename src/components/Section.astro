---
import GridLine from "./GridLine.astro";

interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id}>
	<GridLine />
	<h2>{title}</h2>
	<GridLine />

	<div id="section-content">
		<slot />
	</div>
</section>

<style>
	section {
		width: 100%;
		scroll-margin-top: 1rem;
	}

	h2 {
		margin: 0;
		padding-block: 0.5rem;
	}

	#section-content {
		padding-block: 1rem;
	}
</style>
